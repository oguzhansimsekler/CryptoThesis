(* Symbolic model of the CryptoThesis handshake (protocol version 3) and the first record
   in each direction.
   Run: proverif handshake.pv

   Abstractions: X25519 is Diffie-Hellman with the usual equation; ML-KEM-768 is an ideal KEM
   whose shared secret is the encapsulated value; Ed25519, SHA-256, HKDF-SHA256 and HMAC are
   free functions; AES-256-GCM is an authenticated encryption with associated data.
   The server's signing key is published in phase 1, after all sessions of phase 0 have run,
   so the secrecy queries also cover forward secrecy. *)

free c: channel.

type exponent.
type G.
type key.
type sskey.
type spkey.
type kemsk.
type kempk.

(* X25519 *)
const g: G [data].
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).

(* Ed25519 *)
fun spk(sskey): spkey.
fun sign(bitstring, sskey): bitstring.
reduc forall m: bitstring, k: sskey; verify(sign(m, k), m, spk(k)) = true.

(* ML-KEM-768 *)
fun kempub(kemsk): kempk.
fun kemenc(bitstring, kempk): bitstring.
reduc forall s: bitstring, k: kemsk; kemdec(kemenc(s, kempub(k)), k) = s.

(* SHA-256, HKDF-SHA256 (one output per label), HMAC-SHA256, AES-256-GCM *)
fun hash(bitstring): bitstring.
fun hkdf(G, bitstring, bitstring, bitstring): key.
fun hmac(key, bitstring): bitstring.
fun aenc(bitstring, key, bitstring): bitstring.
reduc forall m: bitstring, k: key, ad: bitstring; adec(aenc(m, k, ad), k, ad) = m.

const labelT, lsf, lcf, lc2s, ls2c, seq1: bitstring.

free clientSecret: bitstring [private].

(* The last argument of the agreement events is the client-to-server key, so agreement
   on the events is also agreement on the session key. *)
event ClientStarted(bitstring, G, kempk).
event ServerSigned(bitstring, G, kempk, bitstring, G, bitstring, key).
event ClientAccepted(bitstring, G, kempk, bitstring, G, bitstring, key).
event ClientSentFinished(bitstring, G, kempk, bitstring, G, bitstring, key).
event ServerConfirmed(bitstring, G, kempk, bitstring, G, bitstring, key).
event ServerReceived(bitstring).
event ClientReceived(bitstring).

(* Secrecy of the client's first record, including forward secrecy. The server echoes it on the
   server-to-client channel, as the hub does, so the query covers the record in both directions. *)
query attacker(clientSecret).

(* Server authentication and key confirmation for the client: each accepting client session
   matches a distinct server session with the same nonces, keys, ciphertext and session key. *)
query nc: bitstring, a: G, ek: kempk, ns: bitstring, b: G, ct: bitstring, k: key;
  inj-event(ClientAccepted(nc, a, ek, ns, b, ct, k)) ==> inj-event(ServerSigned(nc, a, ek, ns, b, ct, k)).

(* Key confirmation for the server. The client is anonymous, so the attacker can always complete
   a handshake as a client of its own; the property is stated for sessions that an honest
   client started: if the server accepts ClientFinished, that client sent it, with the same key. *)
query nc: bitstring, a: G, ek: kempk, ns: bitstring, b: G, ct: bitstring, k: key;
  inj-event(ServerConfirmed(nc, a, ek, ns, b, ct, k)) && event(ClientStarted(nc, a, ek))
  ==> inj-event(ClientSentFinished(nc, a, ek, ns, b, ct, k)).

(* Sanity checks: all should be reported false, which means the honest run reaches client
   acceptance, server confirmation, and the delivery of both records. *)
query nc: bitstring, a: G, ek: kempk, ns: bitstring, b: G, ct: bitstring, k: key; event(ClientAccepted(nc, a, ek, ns, b, ct, k)).
query nc: bitstring, a: G, ek: kempk, ns: bitstring, b: G, ct: bitstring, k: key; event(ServerConfirmed(nc, a, ek, ns, b, ct, k)).
query event(ServerReceived(clientSecret)).
query event(ClientReceived(clientSecret)).

let Client(pkS: spkey) =
  new nc: bitstring;
  new a: exponent;
  new dk: kemsk;
  let A = exp(g, a) in
  let ek = kempub(dk) in
  event ClientStarted(nc, A, ek);
  out(c, (nc, A, ek));
  in(c, (ns: bitstring, B: G, ct: bitstring, pkRecv: spkey, sig: bitstring, sf: bitstring));
  if pkRecv = pkS then
  if verify(sig, (labelT, nc, ns, A, B, ek, ct, pkRecv), pkS) = true then
  let zpq = kemdec(ct, dk) in
  let z = exp(B, a) in
  let h = hash((pkRecv, A, B, ek, ct, nc, ns)) in
  let kc2s = hkdf(z, zpq, h, lc2s) in
  let ks2c = hkdf(z, zpq, h, ls2c) in
  if sf = hmac(hkdf(z, zpq, h, lsf), (h, sig)) then
  event ClientAccepted(nc, A, ek, ns, B, ct, kc2s);
  event ClientSentFinished(nc, A, ek, ns, B, ct, kc2s);
  out(c, hmac(hkdf(z, zpq, h, lcf), (h, sig, sf)));
  out(c, aenc(clientSecret, kc2s, seq1));
  in(c, reply: bitstring);
  let m = adec(reply, ks2c, seq1) in
  event ClientReceived(m).

let Server(skS: sskey) =
  in(c, (nc: bitstring, A: G, ek: kempk));
  new ns: bitstring;
  new b: exponent;
  new zpq: bitstring;
  let B = exp(g, b) in
  let ct = kemenc(zpq, ek) in
  let z = exp(A, b) in
  let pkS = spk(skS) in
  let h = hash((pkS, A, B, ek, ct, nc, ns)) in
  let kc2s = hkdf(z, zpq, h, lc2s) in
  let ks2c = hkdf(z, zpq, h, ls2c) in
  let sig = sign((labelT, nc, ns, A, B, ek, ct, pkS), skS) in
  let sf = hmac(hkdf(z, zpq, h, lsf), (h, sig)) in
  event ServerSigned(nc, A, ek, ns, B, ct, kc2s);
  out(c, (ns, B, ct, pkS, sig, sf));
  in(c, cf: bitstring);
  if cf = hmac(hkdf(z, zpq, h, lcf), (h, sig, sf)) then
  event ServerConfirmed(nc, A, ek, ns, B, ct, kc2s);
  in(c, record: bitstring);
  let m = adec(record, kc2s, seq1) in
  event ServerReceived(m);
  (* Encrypted echo on the server-to-client channel. *)
  out(c, aenc(m, ks2c, seq1)).

process
  new skS: sskey;
  let pkS = spk(skS) in
  out(c, pkS);
  ( (!Client(pkS)) | (!Server(skS)) | (phase 1; out(c, skS)) )
