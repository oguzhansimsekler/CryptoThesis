<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Both are the .NET 10 defaults; set here so that the measured configuration is explicit. -->
    <BlazorWebAssemblyJiterpreter>true</BlazorWebAssemblyJiterpreter>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>

  <!-- Lets the benchmark page show whether it was built with AOT. -->
  <PropertyGroup Condition="'$(RunAOTCompilation)' == 'true'">
    <DefineConstants>$(DefineConstants);AOT_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KriptoLibrary\KriptoLibrary.csproj" />
    <ProjectReference Include="..\KriptoBenchmarks\KriptoBenchmarks.csproj" />
  </ItemGroup>

</Project>
